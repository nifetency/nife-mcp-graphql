# GraphQL MCP Server Configuration
# Copy this file to .env and fill in your values

# GraphQL API Endpoint (REQUIRED)
# Example: https://api.nife.io/graphql
GRAPHQL_ENDPOINT=https://spacex-production.up.railway.app/

# API Access Token (REQUIRED for authenticated queries)
# Get this from your API provider
API_ACCESS_TOKEN=your_access_token_here

# Logging Level (optional)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Query Timeout (optional, in seconds)
# Default: 30
QUERY_TIMEOUT=30

# Schema Cache TTL (optional, in seconds)
# How long to cache the schema before re-introspecting
# Default: 3600 (1 hour)
SCHEMA_CACHE_TTL=3600

# HTTP Server Configuration (optional)
# Enable HTTP endpoint for health checks and metrics
# Default: true
ENABLE_HTTP_ENDPOINT=true

# Server port (optional)
# Default: 8080
MCP_SERVER_PORT=8080

# Server host (optional)
# Default: 0.0.0.0 (all interfaces)
MCP_SERVER_HOST=0.0.0.0


# MCP Mode
#Options : stdio
MCP_MODE=http

