# GraphQL MCP Server - Configuration
# Copy this file to .env and fill in your values
#
# NOTE: When installed as a pip package, you can also configure via:
#   CLI args:     graphql-mcp-server --endpoint URL --token TOKEN
#   Env vars:     export GRAPHQL_ENDPOINT=URL
#   Claude Desktop: use the "env" block in claude_desktop_config.json
#
# Priority: CLI args > real env vars > this .env file > defaults

# ─────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────

# GraphQL API Endpoint
# Example: https://api.nife.io/graphql
GRAPHQL_ENDPOINT=https://spacex-production.up.railway.app/

# API Access Token (leave blank if your API is public)
API_ACCESS_TOKEN=your_access_token_here

# ─────────────────────────────────────────────
# SERVER MODE
# ─────────────────────────────────────────────

# Mode: 'stdio' for MCP clients (Claude Desktop, Cursor)
#       'http'  for Docker / server deployments
MCP_MODE=stdio

# ─────────────────────────────────────────────
# HTTP SERVER (only used when MCP_MODE=http)
# ─────────────────────────────────────────────

ENABLE_HTTP_ENDPOINT=true
MCP_SERVER_PORT=8080
MCP_SERVER_HOST=0.0.0.0

# ─────────────────────────────────────────────
# OPTIONAL TUNING
# ─────────────────────────────────────────────

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# GraphQL request timeout in seconds
QUERY_TIMEOUT=30

# How long to cache the schema before re-introspecting (seconds)
SCHEMA_CACHE_TTL=3600
